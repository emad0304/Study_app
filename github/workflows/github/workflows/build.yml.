name: Build APK
on: [push]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'

      - name: Install Flet
        run: pip install flet

      - name: Prepare and Build
        run: |
          # دستور جدید برای نصب خودکار بدون پرسش
          flet build apk study.py --no-interaction --verbose

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: StudyApp-Android
          path: build/apk/*.apk
