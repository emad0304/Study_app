name: Build APK
on: [push]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'

      - name: Install Flet
        run: pip install flet

      - name: Build APK
        run: |
          # این دستور تمام سوالات نصب را به صورت خودکار تایید می‌کند
          yes | flet build apk study.py

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: StudyApp-Final
          path: build/apk/*.apk
