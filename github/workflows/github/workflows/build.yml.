name: Build APK
on: [push]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'

      - name: Install Flet
        run: pip install flet

      - name: Build APK
        run: |
          # استفاده از دستور yes برای پاسخ خودکار به سوالات نصب Flutter
          yes | flet build apk study.py

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: StudyApp-Final-APK
          path: build/apk/*.apk
